{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tadafile",
  "workers_dev": false,
  "routes": [{ "pattern": "tadafile.com", "custom_domain": true }],
  "main": "./src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*/", "/*/*/", "/*/*/*/"]
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "aditya.contact142@gmail.com" }],
  "vars": {
    "DOC_API_URL": "https://image-toolbox-docs-1025565539524.asia-south1.run.app"
  }
}
