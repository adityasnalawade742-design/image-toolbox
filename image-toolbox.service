[Unit]
Description=Image Toolbox Next.js Production Service
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/image-toolbox
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
Environment=PORT=3000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=image-toolbox

[Install]
WantedBy=multi-user.target
