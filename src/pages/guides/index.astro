---
// The list of guides, newest first
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../../config/site';
import { getBreadcrumbSchema } from '../../lib/seo/schema';
import { allGuides, guideDate } from '../../lib/guides';

const guides = await allGuides();
const url = `${SITE_CONFIG.url}/guides`;
const description = 'Practical answers about images and PDFs: file sizes, formats, print resolution, OCR and how our tools compare, with measurements.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Guides',
    description,
    url,
    inLanguage: 'en',
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: `${url}/${g.id}` })),
  },
  getBreadcrumbSchema([
    { name: 'Home', url: `${SITE_CONFIG.url}/` },
    { name: 'Guides', url },
  ]),
];
---

<BaseLayout title={`Guides | ${SITE_CONFIG.name}`} description={description} canonicalUrl={url} alternates={false} jsonLd={jsonLd}>
  <div class="max-w-[46rem] space-y-8">
    <header class="space-y-3">
      <nav aria-label="Breadcrumb" class="-my-1.5 flex items-center gap-2 text-[14px] text-graphite">
        <a href="/" class="inline-flex items-center min-h-[36px] text-ink hover:underline">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Guides</span>
      </nav>
      <h1 class="font-condensed font-bold text-[34px] sm:text-[48px] leading-[1.02] tracking-[-0.01em] text-ink">Guides</h1>
      <p class="text-[17px] leading-relaxed text-body">{description}</p>
    </header>
    <ul class="divide-y divide-pencil border-y border-ink">
      {guides.map((g) => (
        <li>
          <a href={`/guides/${g.id}`} class="group block py-5 space-y-1.5">
            <h2 class="font-condensed font-bold text-[24px] leading-tight text-ink group-hover:underline">{g.data.title}</h2>
            <p class="text-[16px] leading-snug text-body">{g.data.description}</p>
            <p class="text-[14px] text-graphite" data-measure>{guideDate(g.data.updated ?? g.data.published)}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
