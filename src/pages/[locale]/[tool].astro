---
import ToolLayout from '../../layouts/ToolLayout.astro';
import HubPage from '../../components/hub/HubPage.astro';
import { HUBS, isHub, type HubSlug } from '../../config/hubs';
import { TOOLS } from '../../config/tools';
import { SUPPORTED_LOCALES } from '../../i18n/locales';
import type { SupportedLocale } from '../../i18n/types';
import type { ui } from '../../i18n/ui';

export async function getStaticPaths() {
  const nonDefaultLocales = (Object.keys(SUPPORTED_LOCALES) as SupportedLocale[]).filter((l) => l !== 'en');
  const paths = [];

  for (const locale of nonDefaultLocales) {
    for (const slug of [...TOOLS.map((tool) => tool.slug), ...HUBS.map((hub) => hub.slug)]) {
      paths.push({
        params: {
          locale,
          tool: slug,
        },
      });
    }
  }

  return paths;
}

const { locale, tool } = Astro.params;
---

{isHub(tool as string) ? (
  <HubPage slug={tool as HubSlug} locale={locale as keyof typeof ui} />
) : (
  <ToolLayout slug={tool as string} locale={locale as keyof typeof ui} />
)}
