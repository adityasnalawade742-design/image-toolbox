---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HomeDropZone } from '../../components/shared/HomeDropZone';
import { HomeCategoryTools } from '../../components/shared/HomeCategoryTools';
import { generateWebsiteStructuredData } from '../../lib/seo/schema';
import { SITE_CONFIG } from '../../config/site';
import { NON_DEFAULT_LOCALES } from '../../i18n/locales';
import { getHomeContent } from '../../i18n/home';
import { getUIStrings } from '../../i18n/ui';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((localeConfig) => ({
    params: { locale: localeConfig.code },
    props: { localeConfig },
  }));
}

const { locale } = Astro.params;
const activeLocale = locale || 'en';

const homeData = getHomeContent(activeLocale);
const ui = getUIStrings(activeLocale);
const websiteSchema = generateWebsiteStructuredData(activeLocale);
---

<BaseLayout
  title={`${ui.brandName} — ${ui.tagline}`}
  description={homeData.heroSubheadline || SITE_CONFIG.description}
  locale={activeLocale}
  toolSlug=""
  jsonLdSchemas={[websiteSchema]}
>
  <div class="space-y-20 pb-16">
    
    {/* Hero Section */}
    <section class="relative pt-10 sm:pt-16 pb-12 overflow-hidden border-b border-slate-200/60 dark:border-slate-800/60 bg-gradient-to-b from-sky-500/[0.03] via-transparent to-transparent">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
        
        {/* Trust Pill */}
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 text-xs font-semibold border border-sky-500/20 shadow-sm animate-in fade-in">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{homeData.heroPill}</span>
        </div>

        {/* Hero Headlines */}
        <div class="space-y-4 max-w-4xl mx-auto">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
            {homeData.heroHeadlineMain} <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-sky-500 to-sky-400 bg-clip-text text-transparent">
              {homeData.heroHeadlineAccent}
            </span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
            {homeData.heroSubheadline}
          </p>
        </div>

        {/* Hero DropZone (React Island) */}
        <div class="max-w-2xl mx-auto">
          <HomeDropZone client:load />
        </div>

        {/* Guarantee Badges */}
        <div class="flex flex-wrap items-center justify-center gap-6 pt-4 text-xs font-medium text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>{homeData.guarantee1}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>{homeData.guarantee2}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{homeData.guarantee3}</span>
          </div>
        </div>

      </div>
    </section>

    {/* Tools Grid & Category Filter Section (React Island) */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <HomeCategoryTools client:load locale={activeLocale} />
    </section>

    {/* Why Choose Image Toolbox? (Static HTML) */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 bg-gradient-to-b from-white to-slate-50 dark:from-slate-900/60 dark:to-slate-900/20 shadow-xl shadow-slate-900/5 space-y-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">
            {homeData.whyChooseTitle}
          </h2>
          <p class="text-sm sm:text-base text-slate-500 mt-2">
            {homeData.whyChooseSubtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
          <div class="space-y-3 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-500 flex items-center justify-center font-bold">
              🔒
            </div>
            <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">{homeData.feature1Title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {homeData.feature1Desc}
            </p>
          </div>

          <div class="space-y-3 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-500 flex items-center justify-center font-bold">
              ⚡
            </div>
            <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">{homeData.feature2Title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {homeData.feature2Desc}
            </p>
          </div>

          <div class="space-y-3 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40 backdrop-blur-sm">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-500 flex items-center justify-center font-bold">
              🛠️
            </div>
            <h3 class="font-bold text-base text-slate-900 dark:text-slate-100">{homeData.feature3Title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {homeData.feature3Desc}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Frequently Asked Questions */}
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">
          {ui.frequentlyAskedQuestions}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Everything you need to know about privacy, security, and tool capabilities.
        </p>
      </div>

      <div class="divide-y divide-slate-200 dark:divide-slate-800 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden shadow-sm">
        {homeData.faqs.map((faq) => (
          <details class="group transition-colors">
            <summary class="w-full px-6 py-4 text-left flex items-center justify-between gap-4 font-semibold text-sm sm:text-base text-slate-900 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer list-none select-none">
              <span>{faq.question}</span>
              <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 group-open:text-sky-500 transition-transform duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
