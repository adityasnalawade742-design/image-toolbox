---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { getLocalizedHomeData } from '../../i18n/home';
import { SUPPORTED_LOCALES } from '../../i18n/locales';
import { getFAQSchema } from '../../lib/seo/schema';
import { SITE_CONFIG } from '../../config/site';
import type { SupportedLocale } from '../../i18n/types';

export async function getStaticPaths() {
  const locales = (Object.keys(SUPPORTED_LOCALES) as SupportedLocale[]).filter((l) => l !== 'en');
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as SupportedLocale;
const homeData = getLocalizedHomeData(locale);
const faqSchema = getFAQSchema(homeData.faqs);
---

<BaseLayout
  title={`${homeData.hero.title} | ${SITE_CONFIG.name}`}
  description={homeData.hero.subtitle}
  currentSlug=""
  canonicalUrl={`${SITE_CONFIG.url}/${locale}/`}
  jsonLd={faqSchema ? [faqSchema] : undefined}
>
  <HomePage locale={locale} />
</BaseLayout>
