---
import { SITE_CONFIG } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LanguageBanner } from '../components/layout/LanguageBanner';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getHreflangLinks, SUPPORTED_LOCALES } from '../i18n/locales';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
  /** False for pages that exist only in English, so no hreflang alternates point at missing pages */
  alternates?: boolean;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  currentSlug = '',
  canonicalUrl,
  jsonLd,
  alternates = true,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hreflangLinks = alternates ? getHreflangLinks(currentSlug, SITE_CONFIG.url) : [];
const currentCanonical = canonicalUrl || `${SITE_CONFIG.url}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.author} />
    <link rel="canonical" href={currentCanonical} />
    
    <!-- Hreflang Multi-Country Internationalization -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbfbf9" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ImageToolbox" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content={SUPPORTED_LOCALES[lang]?.hrefLang || 'en'} />

    <!-- Structured Data JSON-LD -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-paper text-ink flex flex-col font-sans">
    <a href="#main" class="skip-link">{t('nav.skip')}</a>
    <LanguageBanner client:idle currentLocale={lang} currentSlug={currentSlug} />
    <Header locale={lang} currentSlug={currentSlug} />
    
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <slot />
    </main>

    <Footer locale={lang} />
  </body>
</html>
