---
import { SITE_CONFIG } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LanguageBanner } from '../components/layout/LanguageBanner';
import { getLangFromUrl } from '../i18n/utils';
import { getHreflangLinks } from '../i18n/locales';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  currentSlug = '',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const hreflangLinks = getHreflangLinks(currentSlug, SITE_CONFIG.url);
const currentCanonical = canonicalUrl || `${SITE_CONFIG.url}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_CONFIG.author} />
    <link rel="canonical" href={currentCanonical} />
    
    <!-- Hreflang Multi-Country Internationalization -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#07080a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ImageToolbox" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />

    <!-- Structured Data JSON-LD -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-canvas text-ink flex flex-col font-sans">
    <LanguageBanner client:idle currentLocale={lang} currentSlug={currentSlug} />
    <Header locale={lang} currentSlug={currentSlug} />
    
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <Footer locale={lang} />
  </body>
</html>
