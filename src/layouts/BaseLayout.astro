---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LanguageBanner } from '../components/layout/LanguageBanner';
import { SITE_CONFIG } from '../config/site';
import { getHreflangLinks, getLocalizedUrl } from '../i18n/locales';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  jsonLdSchemas?: Record<string, unknown>[];
  ogImage?: string;
  locale?: string;
  toolSlug?: string;
}

const {
  locale = 'en',
  toolSlug = '',
  title = `${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`,
  description = SITE_CONFIG.description,
  canonicalUrl,
  jsonLdSchemas = [],
  ogImage = `${SITE_CONFIG.url}/og-image.png`,
} = Astro.props;

const baseSiteUrl = (SITE_CONFIG.url || 'https://image-toolbox.aditya-s-nalawade742.workers.dev').replace(/\/+$/, '');
const computedCanonical = canonicalUrl || `${baseSiteUrl}${getLocalizedUrl(toolSlug, locale)}`;
const hreflangList = getHreflangLinks(toolSlug, baseSiteUrl);
---

<!doctype html>
<html lang={locale} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={computedCanonical} />

    {/* Exact Absolute Multi-Country Hreflang Tags + x-default */}
    {hreflangList.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.href} />
    ))}

    {/* Favicon & Theme */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#090d16" />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    {/* Open Graph / Social */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={computedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* JSON-LD Schemas */}
    {jsonLdSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* Inline Theme Init Script */}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-[#090d16] bg-grid-pattern text-slate-900 dark:text-slate-100 antialiased font-sans">
    {/* Non-intrusive Language Recommendation Banner */}
    <LanguageBanner client:idle currentLocale={locale} toolSlug={toolSlug} />
    
    <Header locale={locale} toolSlug={toolSlug} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
