---
import { LanguageSelector } from './LanguageSelector';
import { ToolSearch } from '../shared/ToolSearch';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getLocalizedHomeData } from '../../i18n/home';
import { CATEGORY_INK, CATEGORY_ORDER } from '../../config/inks';
import { SITE_CONFIG } from '../../config/site';
import { ui } from '../../i18n/ui';
import { pickStrings } from '../../i18n/strings';

interface Props {
  locale?: keyof typeof ui;
  currentSlug?: string;
}

const { locale = 'en', currentSlug = '' } = Astro.props;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const categoryNames = getLocalizedHomeData(locale).categoryNames;
const searchStrings = pickStrings(locale, 'search.');
const langStrings = pickStrings(locale, 'lang.');
// The developer section is small; the masthead lists the four everyday categories
const navCategories = CATEGORY_ORDER.filter((c) => c !== 'developer');
// Five categories only fit the 1280px masthead (next to search and language) with their short names
const SHORT_NAV_KEY = {
  'edit-transform': 'nav.edit',
  'optimize-compress': 'nav.compress',
  'convert-formats': 'nav.convert',
  'pdf-documents': 'nav.pdf',
  utilities: 'nav.utilities',
} as const;
const navLabel = (cat: (typeof navCategories)[number]) => (cat in SHORT_NAV_KEY ? t(SHORT_NAV_KEY[cat as keyof typeof SHORT_NAV_KEY]) : categoryNames[cat]);
---

<header class="sticky top-0 z-40 w-full bg-paper border-b border-ink">
  <div class="color-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-2 sm:gap-4">
    <a href={translatePath('/')} class="flex items-center gap-2.5 shrink-0" aria-label={`${SITE_CONFIG.name}, ${t('nav.allTools')}`}>
      <svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="5.5" />
        <path d="M12 2v20M2 12h20" />
      </svg>
      <span class="font-condensed font-bold text-[17px] uppercase tracking-[0.04em] text-ink leading-none">
        {SITE_CONFIG.name}
      </span>
    </a>

    <nav class="hidden xl:flex items-center gap-5" aria-label={t('nav.allTools')}>
      {navCategories.map((cat) => (
        <a
          href={translatePath(`/#${cat}`)}
          class="flex items-center gap-2 whitespace-nowrap text-[15px] font-medium text-ink hover:underline"
        >
          <span class:list={['w-2.5 h-2.5 shrink-0', CATEGORY_INK[cat].className]} aria-hidden="true"></span>
          {navLabel(cat)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ToolSearch client:idle locale={locale} strings={searchStrings} />
      <LanguageSelector client:idle currentLocale={locale} currentSlug={currentSlug} languageLabel={langStrings['lang.label']} />
    </div>
  </div>
</header>
