---
import { ToolSearch } from '../shared/ToolSearch';
import { LanguageSelector } from './LanguageSelector';
import { getUIStrings } from '../../i18n/ui';
import { getLocalizedUrl } from '../../i18n/locales';

interface Props {
  locale?: string;
  toolSlug?: string;
}

const { locale = 'en', toolSlug = '' } = Astro.props;
const ui = getUIStrings(locale);

const homeUrl = getLocalizedUrl('', locale);
const allToolsUrl = `${homeUrl}#tools`;
const cropUrl = getLocalizedUrl('crop-image', locale);
const compressUrl = getLocalizedUrl('compress-image', locale);
const resizeUrl = getLocalizedUrl('resize-image', locale);
const convertUrl = getLocalizedUrl('convert-image', locale);
const faviconUrl = getLocalizedUrl('favicon-generator', locale);
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-[#090d16]/80 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3 sm:gap-4">
    
    {/* Left: Brand Logo & Tag */}
    <div class="flex items-center gap-4 sm:gap-6">
      <a href={homeUrl} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-lg p-1">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-600 to-sky-400 flex items-center justify-center text-white shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-sky-500 transition-colors">
            {ui.brandName}
          </span>
          <span class="text-[10px] font-medium text-slate-500 -mt-1 hidden sm:inline-block">
            {ui.tagline}
          </span>
        </div>
      </a>

      {/* Privacy Trust Badge */}
      <div class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20">
        <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>{ui.privacyBadge}</span>
      </div>
    </div>

    {/* Center / Right: Search, Language Switcher & Theme */}
    <div class="flex items-center gap-2 sm:gap-3">
      
      {/* React Island: Tool Search (Ctrl+K modal with localized search) */}
      <ToolSearch client:idle locale={locale} />

      {/* Desktop Quick Nav */}
      <nav class="hidden md:flex items-center gap-1">
        <a href={allToolsUrl} class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
          {ui.allTools}
        </a>
        <a href={cropUrl} class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
          Crop
        </a>
        <a href={compressUrl} class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
          Compress
        </a>
        <a href={convertUrl} class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
          Convert
        </a>
      </nav>

      <div class="h-4 w-px bg-slate-200 dark:bg-slate-800 hidden sm:block"></div>

      {/* Language Selector React Island */}
      <LanguageSelector client:load currentLocale={locale} toolSlug={toolSlug} />

      {/* Theme Toggle Button */}
      <button 
        id="theme-toggle-btn"
        type="button" 
        class="p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="Toggle Theme"
      >
        <svg class="w-4 h-4 hidden dark:block fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="w-4 h-4 block dark:hidden fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      {/* Mobile Menu Button */}
      <button 
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800"
        aria-label="Open Navigation Menu"
      >
        <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Menu Dropdown */}
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#090d16] px-4 py-4 space-y-2">
    <a href={allToolsUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      {ui.allTools}
    </a>
    <a href={cropUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      Crop Image
    </a>
    <a href={resizeUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      Resize Image
    </a>
    <a href={compressUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      Compress Image
    </a>
    <a href={convertUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      Convert Image
    </a>
    <a href={faviconUrl} class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800">
      Favicon Generator
    </a>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle-btn');
  themeBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
