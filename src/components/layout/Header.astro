---
import Logo from './Logo.astro';
import { LanguageSelector } from './LanguageSelector';
import { ToolSearch } from '../shared/ToolSearch';
import { searchIndexUrl } from '../../i18n/searchItems';
import { TOOLS } from '../../config/tools';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getLocalizedHomeData } from '../../i18n/home';
import { CATEGORY_INK, CATEGORY_ORDER } from '../../config/inks';
import { HUB_FOR_CATEGORY } from '../../config/hubs';
import { ui } from '../../i18n/ui';
import { pickStrings } from '../../i18n/strings';

interface Props {
  locale?: keyof typeof ui;
  currentSlug?: string;
}

const { locale = 'en', currentSlug = '' } = Astro.props;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const categoryNames = getLocalizedHomeData(locale).categoryNames;
const searchStrings = pickStrings(locale, 'search.');
const langStrings = pickStrings(locale, 'lang.');
// The developer section is small; the masthead lists the four everyday categories
const navCategories = CATEGORY_ORDER.filter((c) => c !== 'developer');
// Five categories only fit the 1280px masthead (next to search and language) with their short names
const SHORT_NAV_KEY = {
  'edit-transform': 'nav.edit',
  'optimize-compress': 'nav.compress',
  'convert-formats': 'nav.convert',
  'pdf-documents': 'nav.pdf',
  utilities: 'nav.utilities',
} as const;
const navLabel = (cat: (typeof navCategories)[number]) => (cat in SHORT_NAV_KEY ? t(SHORT_NAV_KEY[cat as keyof typeof SHORT_NAV_KEY]) : categoryNames[cat]);
---

<header class="sticky top-0 z-40 w-full bg-paper-bright border-b border-pencil">
  <div class="color-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-2 sm:gap-4">
    <a href={translatePath('/')} class="flex items-center gap-2.5 shrink-0">
      <Logo class="text-[30px]" /><span class="sr-only">, {t('nav.allTools')}</span>
    </a>

    <!-- Plain links, each with its category's ink dot: the colour bar and the logo already carry the colour -->
    <nav class="hidden xl:flex items-center gap-1" aria-label={t('nav.allTools')}>
      {navCategories.map((cat) => (
        <a href={translatePath(HUB_FOR_CATEGORY[cat] ? `/${HUB_FOR_CATEGORY[cat]}` : `/#${cat}`)} class="flex items-center gap-2 whitespace-nowrap rounded-md px-3 py-1.5 text-[15px] font-medium !text-ink hover:bg-paper-stock">
          <span class:list={['w-2 h-2 shrink-0 rounded-full', CATEGORY_INK[cat].className]} aria-hidden="true"></span>
          {navLabel(cat)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ToolSearch client:idle locale={locale} strings={searchStrings} count={TOOLS.length} indexUrl={searchIndexUrl(locale)} />
      <!-- Light / dark switch: a moon on the paper, a sun on the negative. Pressed = dark. The page script in BaseLayout
           sets the theme before paint; this only flips it and keeps the button's state in step -->
      <button type="button" class="theme-switch btn-rule w-10 h-10 min-h-[40px] px-0 shrink-0" aria-pressed="false" aria-label={t('nav.darkTheme')} title={t('nav.darkTheme')}>
        <svg class="theme-moon w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" /></svg>
        <svg class="theme-sun w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
      </button>
      <LanguageSelector client:idle currentLocale={locale} currentSlug={currentSlug} languageLabel={langStrings['lang.label']} />
    </div>
  </div>
</header>

<script>
  const switches = document.querySelectorAll<HTMLButtonElement>('.theme-switch');
  const theme = window as unknown as { tfTheme?: { get(): string; set(t: string): void } };
  const sync = () => switches.forEach((b) => b.setAttribute('aria-pressed', String(theme.tfTheme?.get() === 'dark')));
  sync();
  document.addEventListener('tf-theme', sync);
  switches.forEach((b) => b.addEventListener('click', () => theme.tfTheme?.set(theme.tfTheme.get() === 'dark' ? 'light' : 'dark')));
</script>

<style>
  .theme-sun { display: none; }
  :global([data-theme='dark']) .theme-sun { display: block; }
  :global([data-theme='dark']) .theme-moon { display: none; }
</style>
