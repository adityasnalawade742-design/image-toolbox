---
import { TOOLS } from '../../config/tools';
import { CATEGORY_INK, CATEGORY_ORDER } from '../../config/inks';
import { SITE_CONFIG } from '../../config/site';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getLocalizedHomeData } from '../../i18n/home';
import { getAllLocalizedTools } from '../../i18n/tools';
import { ui } from '../../i18n/ui';

interface Props {
  locale?: keyof typeof ui;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const categoryNames = getLocalizedHomeData(locale).categoryNames;
const locTools = getAllLocalizedTools(locale);
const popularTools = TOOLS.filter((tool) => tool.popular).slice(0, 6);
// Information pages exist in English only; other languages link to them
const infoLinks = [
  { href: '/about', key: 'footer.about' },
  { href: '/contact', key: 'footer.contact' },
  { href: '/privacy', key: 'footer.privacyPolicy' },
  { href: '/terms', key: 'footer.terms' },
  { href: '/accessibility', key: 'footer.accessibility' },
] as const;
---

<footer class="mt-24 border-t border-ink bg-paper">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-3 max-w-sm">
      <p class="font-condensed font-bold text-[17px] uppercase tracking-[0.04em]">{SITE_CONFIG.name}</p>
      <p class="text-[15px] text-body leading-relaxed">{t('footer.tagline')}</p>
      <p class="text-[13px] text-graphite" data-measure>{t('footer.toolCount').replace('{count}', String(TOOLS.length))}</p>
    </div>

    <div>
      <h2 class="slug mb-3">{t('footer.popular')}</h2>
      <ul class="text-[15px]">
        {popularTools.map((tool) => (
          <li>
            <a href={translatePath(`/${tool.slug}`)} class="flex items-center gap-2 min-h-[36px] text-ink hover:underline">
              <span class:list={['w-2 h-2 shrink-0 rounded-full', CATEGORY_INK[tool.category].className]} aria-hidden="true"></span>
              {locTools[tool.slug]?.name || tool.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="slug mb-3">{t('footer.categories')}</h2>
      <ul class="text-[15px]">
        {CATEGORY_ORDER.map((cat) => (
          <li>
            <a href={translatePath(`/#${cat}`)} class="flex items-center gap-2 min-h-[36px] text-ink hover:underline">
              <span class:list={['w-2 h-2 shrink-0 rounded-full', CATEGORY_INK[cat].className]} aria-hidden="true"></span>
              {categoryNames[cat]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-pencil">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[13px] text-graphite">
      <p>© {new Date().getFullYear()} {SITE_CONFIG.name}</p>
      <div class="space-y-1 sm:text-right">
        <ul class="flex flex-wrap items-center gap-x-5 sm:justify-end">
          {infoLinks.map((l) => (
            <li><a href={l.href} hreflang={locale === 'en' ? undefined : 'en'} class="inline-flex items-center min-h-[36px] text-ink hover:underline">{t(l.key)}</a></li>
          ))}
          <li><a href={SITE_CONFIG.sourceUrl} rel="noopener" class="inline-flex items-center min-h-[36px] text-ink hover:underline">{t('footer.source')}</a></li>
          <li><a href="/sitemap.xml" class="inline-flex items-center min-h-[36px] text-ink hover:underline">{t('footer.sitemap')}</a></li>
        </ul>
        {locale !== 'en' && <p class="text-[13px] text-graphite">{t('footer.infoInEnglish')}</p>}
      </div>
    </div>
  </div>
</footer>
