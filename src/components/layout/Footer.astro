---
import { SITE_CONFIG } from '../../config/site';
import { TOOLS } from '../../config/tools';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import { ui } from '../../i18n/ui';

interface Props {
  locale?: keyof typeof ui;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const popularTools = TOOLS.filter((tool) => tool.popular);
---

<footer class="border-t border-hairline bg-surface mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1 -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-surface-card border border-hairline flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-accent-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M6 2v14a2 2 0 0 0 2 2h14"/>
              <path d="M18 22V8a2 2 0 0 0-2-2H2"/>
            </svg>
          </div>
          <span class="font-semibold text-sm text-ink">Image Toolbox</span>
        </div>
        <p class="text-xs text-mute leading-relaxed max-w-md">
          {t('footer.privacy')}
        </p>
        <div class="flex items-center gap-2 text-[11px] text-accent-green font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-green animate-pulse"></span>
          <span>100% In-Browser HTML5 Canvas Processing</span>
        </div>
      </div>

      <!-- Col 2: Popular Tools -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink">Popular Tools</h4>
        <ul class="space-y-2 text-xs">
          {popularTools.slice(0, 5).map((tool) => (
            <li>
              <a href={translatePath(`/${tool.slug}`)} class="text-mute hover:text-ink transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink">Categories</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={translatePath('/#edit-transform')} class="text-mute hover:text-ink transition-colors">Edit & Transform</a></li>
          <li><a href={translatePath('/#optimize-compress')} class="text-mute hover:text-ink transition-colors">Optimize & Compress</a></li>
          <li><a href={translatePath('/#convert-formats')} class="text-mute hover:text-ink transition-colors">Convert Formats</a></li>
          <li><a href={translatePath('/#utilities')} class="text-mute hover:text-ink transition-colors">Inspect & Utilities</a></li>
          <li><a href={translatePath('/#developer')} class="text-mute hover:text-ink transition-colors">Developer Tools</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-hairline mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute">
      <p>© {new Date().getFullYear()} Image Toolbox. {t('footer.rights')}</p>
      <div class="flex items-center gap-6">
        <a href={translatePath('/sitemap.xml')} class="hover:text-ink transition-colors">Sitemap</a>
        <a href={translatePath('/robots.txt')} class="hover:text-ink transition-colors">Robots</a>
        <a href="https://github.com/adityasnalawade742-design/image-toolbox" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
