---
import { TOOLS_REGISTRY, CATEGORIES_CONFIG } from '../../config/tools';
import { SITE_CONFIG } from '../../config/site';

const currentYear = new Date().getFullYear();
const activeTools = TOOLS_REGISTRY.filter((t) => t.status === 'active');

const editTools = activeTools.filter((t) => t.category === 'edit');
const optimizeTools = activeTools.filter((t) => t.category === 'optimize');
const convertTools = activeTools.filter((t) => t.category === 'convert');
const utilDevTools = activeTools.filter((t) => t.category === 'utilities' || t.category === 'developer');
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#0c121e] text-slate-600 dark:text-slate-400 text-xs mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    
    {/* Top Feature Highlights */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pb-8 border-b border-slate-200 dark:border-slate-800/80 text-center sm:text-left">
      <div class="flex items-center gap-3 justify-center sm:justify-start">
        <div class="p-2.5 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400">
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div>
          <div class="font-semibold text-slate-900 dark:text-slate-100 text-sm">100% Private Processing</div>
          <div class="text-slate-500 text-xs">Images never leave your browser</div>
        </div>
      </div>

      <div class="flex items-center gap-3 justify-center sm:justify-start">
        <div class="p-2.5 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400">
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <div>
          <div class="font-semibold text-slate-900 dark:text-slate-100 text-sm">Ultra-Fast & Free</div>
          <div class="text-slate-500 text-xs">No registration, no limits, instant exports</div>
        </div>
      </div>

      <div class="flex items-center gap-3 justify-center sm:justify-start">
        <div class="p-2.5 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400">
          <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div>
          <div class="font-semibold text-slate-900 dark:text-slate-100 text-sm">Zero Loss Quality</div>
          <div class="text-slate-500 text-xs">High-fidelity HTML5 Canvas engine</div>
        </div>
      </div>
    </div>

    {/* Directory Columns */}
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      
      {/* Brand Col */}
      <div class="col-span-2 md:col-span-1 space-y-3">
        <div class="flex items-center gap-2 text-slate-900 dark:text-slate-100 font-bold text-base">
          <div class="w-6 h-6 rounded-lg bg-sky-500 flex items-center justify-center text-white text-xs font-black">
            IT
          </div>
          <span>Image Toolbox</span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          {SITE_CONFIG.description}
        </p>
      </div>

      {/* Edit Tools */}
      <div class="space-y-3">
        <div class="font-semibold text-slate-900 dark:text-slate-200 text-sm">
          Edit & Transform
        </div>
        <ul class="space-y-2">
          {editTools.map((tool) => (
            <li>
              <a href={`/${tool.slug}`} class="hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Optimize Tools */}
      <div class="space-y-3">
        <div class="font-semibold text-slate-900 dark:text-slate-200 text-sm">
          Optimize & Compress
        </div>
        <ul class="space-y-2">
          {optimizeTools.map((tool) => (
            <li>
              <a href={`/${tool.slug}`} class="hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Convert Tools */}
      <div class="space-y-3">
        <div class="font-semibold text-slate-900 dark:text-slate-200 text-sm">
          Convert Formats
        </div>
        <ul class="space-y-2">
          {convertTools.map((tool) => (
            <li>
              <a href={`/${tool.slug}`} class="hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Utilities & Dev Tools */}
      <div class="space-y-3">
        <div class="font-semibold text-slate-900 dark:text-slate-200 text-sm">
          Utilities & Dev
        </div>
        <ul class="space-y-2">
          {utilDevTools.map((tool) => (
            <li>
              <a href={`/${tool.slug}`} class="hover:text-sky-500 dark:hover:text-sky-400 transition-colors">
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    {/* Bottom Bar */}
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
      <div>
        © {currentYear} Image Toolbox. All rights reserved. Free, open, browser-side utilities.
      </div>
      <div class="flex items-center gap-4">
        <span>Processed 100% locally on your device via HTML5 Canvas.</span>
      </div>
    </div>

  </div>
</footer>
